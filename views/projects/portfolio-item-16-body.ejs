<% /* Introduction */ %>
<section class="portfolio-item__intro">
    <div class="portfolio-item-intro__content">
        <% /* Header */ %>
        <div class="portfolio-item-intro__text">
            <h1 class="portfolio-item__title--intro">
                FreelanceOS
            </h1>
            <p class="portfolio-item__subtitle--intro">
                A production-ready freelance operations platform for time tracking, client and contract management,
                invoicing, payment visibility, and revenue analytics, built with Next.js, TypeScript, PostgreSQL,
                Prisma, and Better Auth.
            </p>

            <% /* Link to live site */ %>
            <p class="portfolio-item-links">
                <a href="https://freelance-os-timeplan.vercel.app/" target="_blank"
                    rel="noopener noreferrer" class="btn">
                    <i class="fas fa-external-link-alt"></i> Visit Live Demo
                </a>
                <a href="https://github.com/gianmarioiamoni/freelance-os" target="_blank"
                    rel="noopener noreferrer" class="btn btn--secondary">
                    <i class="fab fa-github"></i> View on GitHub
                </a>
            </p>

            <p class="portfolio-item-description">
                FreelanceOS is a full-stack web application designed to bring the core operational workflows of an
                independent professional into one workspace. It connects time entries to clients and contracts,
                preserves billing details for historical consistency, tracks invoices and payments, and surfaces
                revenue and contract-capacity indicators through dashboards and reports. The application uses a
                layered architecture with domain, application, infrastructure, and feature boundaries; workspace-level
                data isolation; Better Auth authentication; and Prisma-managed PostgreSQL migrations. Its reporting
                capabilities include period-based revenue visibility, client and timesheet analysis, and exportable
                invoice and cash reports. An AI Assistant interface is also available for natural-language queries
                over workspace analytics, with its production provider configuration kept explicitly separate.
            </p>
        </div>

        <% /* Image */ %>
        <img src="https://github.com/user-attachments/assets/0e41a147-e8a9-44ef-81db-69223b53548d"
            alt="FreelanceOS Dashboard" class="portfolio-item-intro__img fade-in-image">
    </div>
</section>

